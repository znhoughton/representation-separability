data/experiment7_reps/
data/experiment8_reps_shard1/*.npz
data/experiment8_reps_shard0/*.npz

# LLM contextual reps (~325 GB, regenerable via run_llm_sweep.py) -- results CSVs stay tracked
data/llm_reps/
# Experiment 9 unified-grid saved reps (~8 GB, regenerable) -- CSVs stay tracked
data/experiment9_reps/
# editor / tool dirs
.idea/
.vscode/
.claude/
data/vua_reps/
# superseded scripts/analyses/data, kept on disk for reference (regenerable, out of the tree)
/archive/
# all saved representation dirs (large, regenerable) -- catch-all; result CSVs stay tracked
data/*_reps/
# per-cell toy artefacts: hidden states plus the raw null draws, ~8 GB for the full grid. Kept
# so a change to what we MEASURE costs a re-measure rather than retraining the whole grid.
data/toy_runs/
# raw null draws from the LLM side; small, but regenerable from the saved representations
data/llm_nulls/
# concatenated / single UD corpora (regenerable via scripts/llm/build_concat_ud.py) -- CSVs stay tracked
data/ud/
# Quarto paper build artifacts. The generated TeX is disposable; the rendered paper, the ACL
# extension and the exported figures are tracked.
paper/*.pdf
!paper/fig-training.pdf
!paper/fig-measurement.pdf
!paper/fig-grid.pdf
!paper/fig-projection.pdf
!paper/fig-replication.pdf
!paper/separability.pdf
paper/*.tex
# Quarto copies these out of the extension into paper/ at render time
paper/acl.sty
paper/acl_natbib.bst
paper/.quarto/
paper/*_files/
# stray shell / editor / tool dotfiles at repo root (personal env — never commit)
/.bash_profile
/.bashrc
/.profile
/.zprofile
/.zshrc
/.gitconfig
/.gitmodules
/.ripgreprc
/.mcp.json
/.idea
/.vscode

# Run logs (regenerable, and noisy in diffs)
/logs/

# Working notes. The drawio sources under notes/figures/ stay tracked: they are the
# editable originals for the paper's fig-grid, fig-projection, fig-splits and
# fig-replication PDFs.
/notes/how-the-measure-works.md
/notes/figures/*.png
/notes/figures/*.svg
/notes/figures/*.pdf

# Superseded scripts and analyses. On disk, out of the index; all of it is in git history.
/archive/

# Superseded CSVs, moved aside with a timestamp whenever a run rebuilds one. They accumulate
# every run and every one of them is reconstructible; git history holds the versions that mattered.
/old/

# knitr's figure output for the plotting chunks. Regenerated by every render.
/paper/figure/

# Developer and operator tooling: GPU benchmarks and the pre-run sizing/correctness check. Both are
# reproducible from the pipeline and useful locally, but they are not part of it. Kept on disk.
/scripts/dev/
/scripts/preflight_validation.py

# uncompressed copy of the canonical validate_measure.csv.gz (local working file)
/data/validate_measure.csv

# Quick-and-dirty per-item frequency analysis (future-paper exploration, not a
# pipeline artifact): scripts, outputs, everything under here is untracked on purpose.
/analysis/

# LaTeX build artifacts from a manual pdflatex pass (quarto cleans its own)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
