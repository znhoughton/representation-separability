# Superseded scripts and analyses. On disk, out of the index; all of it is in git history.
/archive/

# Superseded CSVs, moved aside with a timestamp whenever a run rebuilds one. They accumulate
# every run and every one of them is reconstructible; git history holds the versions that mattered.
/old/

# knitr's figure output for the plotting chunks. Regenerated by every render.
/paper/figure/

# Developer and operator tooling: GPU benchmarks and diagnostics. Reproducible from the pipeline and
# useful locally, but not part of it. Kept on disk, out of the tree.
/scripts/dev/

# uncompressed copy of the canonical validate_measure.csv.gz (local working file)
/data/validate_measure.csv

# Quick-and-dirty per-item frequency analysis (future-paper exploration, not a
# pipeline artifact): scripts, outputs, everything under here is untracked on purpose.
/analysis/

# LaTeX build artifacts from a manual pdflatex pass (quarto cleans its own)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out

# scratch renders for comparing figure options, not part of the paper
figure-candidates/

# Demo artifacts from the component-model scripts. DEMO=1 subsamples the grid and
# runs a fraction of the draws, so these must never reach the paper; they are
# suffixed _demo precisely so they cannot be confused with the reported numbers.
*_demo.csv
*_demo.pdf
*_demo.png

# Fitted brms/ordbetareg objects. Reproducible from the scripts with seed 964, and ~206MB each
# at the reported budget, which is past GitHub's 100MB per-file limit. The component-model fits
# are kept anyway, through LFS, because regenerating them costs about an hour of compute per
# model; everything else under model_cache stays out.
#
# NOTE on removing them later: deleting the file in a future commit does NOT reclaim the LFS
# object on the remote, and GitHub offers no way to purge one. Treat pushing these as permanent.
#
# Negations need dir/* rather than dir/: git will not re-include a file whose parent directory
# is itself excluded, so excluding the contents and then re-including by name is the only form
# that works here.
model_cache/*
!model_cache/toy/
model_cache/toy/*
!model_cache/toy/ordbeta_size_item.rds
!model_cache/toy/ordbeta_size_class.rds
!model_cache/toy/ordbeta_size_interaction.rds
!model_cache/toy/ordbeta_size_item_linear.rds
!model_cache/toy/ordbeta_size_class_linear.rds
!model_cache/toy/ordbeta_size_interaction_linear.rds

# Run logs from the component-model fits
toy_models_full.log

# The paper source carries the author block in its YAML header, so it is kept out of
# the public repository while the work is under double-blind review. Re-add it with
# `git add -f` once the paper is accepted.
paper/separability.qmd