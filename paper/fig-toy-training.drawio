        <mxCell id="eq" value="softmax&amp;nbsp; s [ &amp;nbsp;w&lt;sub&gt;α&lt;/sub&gt; · item(&lt;i&gt;dog&lt;/i&gt;)&amp;nbsp; + &amp;nbsp;w&lt;sub&gt;β&lt;/sub&gt; · class(&lt;i&gt;noun&lt;/i&gt;)&amp;nbsp; + &amp;nbsp;w&lt;sub&gt;γ&lt;/sub&gt; · ( item(&lt;i&gt;dog&lt;/i&gt;) ⊙ class(&lt;i&gt;noun&lt;/i&gt;) )&amp;nbsp; + &amp;nbsp;w&lt;sub&gt;ctx&lt;/sub&gt; · context(#9) ]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#FFFFFF;strokeColor=#154733;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="288" width="768" height="46" as="geometry" />
        </mxCell>

        <mxCell id="note" value="⊙ is the elementwise product. A sum splits into an item part plus a class part; a product does not — that term is what no decomposition into the two can absorb. Each term is generated independently and normalized to unit scale, so the weights set composition only: total signal strength is constant across the grid." style="text;html=1;fontSize=11;align=left;verticalAlign=top;fontColor=#404040;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="344" width="768" height="56" as="geometry" />
        </mxCell>

        <mxCell id="cellnote" value="Every (form, class) cell&#10;is observed 24 times,&#10;each in a different context.&#10;&#10;That within-cell variation&#10;is what the measurement&#10;splits in half." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FBF7EE;strokeColor=#F0B323;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
