          <mxGeometry x="36" y="52" width="420" height="20" as="geometry" />
        </mxCell>
        <mxCell id="Abox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CCCCCC;dashed=1;" vertex="1" parent="1">
