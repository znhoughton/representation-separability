        <mxCell id="ttl" value="What separability looks like geometrically, and how each part is computed" style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="36" y="14" width="800" height="26" as="geometry" />
        </mxCell>

        <!-- ================= A: cells to cell means ================= -->
