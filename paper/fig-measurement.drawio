        <mxCell id="Ac1" value="" style="ellipse;html=1;fillColor=#F0B323;strokeColor=none;opacity=45;" vertex="1" parent="1"><mxGeometry x="72" y="106" width="9" height="9" as="geometry" /></mxCell>
        <mxCell id="Ac2" value="" style="ellipse;html=1;fillColor=#F0B323;strokeColor=none;opacity=45;" vertex="1" parent="1"><mxGeometry x="92" y="126" width="9" height="9" as="geometry" /></mxCell>
        <mxCell id="Ac3" value="" style="ellipse;html=1;fillColor=#F0B323;strokeColor=none;opacity=45;" vertex="1" parent="1"><mxGeometry x="66" y="140" width="9" height="9" as="geometry" /></mxCell>
        <mxCell id="Ac4" value="" style="ellipse;html=1;fillColor=#F0B323;strokeColor=none;opacity=45;" vertex="1" parent="1"><mxGeometry x="104" y="152" width="9" height="9" as="geometry" /></mxCell>
        <mxCell id="Ac5" value="" style="ellipse;html=1;fillColor=#F0B323;strokeColor=none;opacity=45;" vertex="1" parent="1"><mxGeometry x="84" y="166" width="9" height="9" as="geometry" /></mxCell>
        <mxCell id="Acen" value="" style="ellipse;html=1;fillColor=#875E00;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="82" y="136" width="15" height="15" as="geometry" /></mxCell>
        <mxCell id="Alab" value="24 tokens of &lt;i&gt;dog&lt;/i&gt;-as-noun,&#10;one per context" style="text;html=1;fontSize=10;align=left;fontColor=#404040;" vertex="1" parent="1">
          <mxGeometry x="120" y="98" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="Alab2" value="their mean = M[&lt;i&gt;dog&lt;/i&gt;, noun]" style="text;html=1;fontSize=10;align=left;fontColor=#875E00;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="120" y="158" width="170" height="20" as="geometry" />
        </mxCell>
        <mxCell id="Aarr" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#6E6E6E;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="290" y="150" as="sourcePoint" /><mxPoint x="336" y="150" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="Agrid" value="a grid of cell means&#10;M[item, class]&#10;&#10;one vector per cell" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FBF7EE;strokeColor=#875E00;" vertex="1" parent="1">
          <mxGeometry x="344" y="112" width="124" height="76" as="geometry" />
        </mxCell>

        <!-- ================= B: the parallelogram ================= -->
        <mxCell id="Bh" value="B.&amp;nbsp; Separable means the cell means form a parallelogram" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="36" y="238" width="500" height="20" as="geometry" />
        </mxCell>
        <mxCell id="Bbox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CCCCCC;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="260" width="440" height="240" as="geometry" />
        </mxCell>

        <mxCell id="P11" value="" style="ellipse;html=1;fillColor=#154733;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="96" y="426" width="12" height="12" as="geometry" /></mxCell>
        <mxCell id="P21" value="" style="ellipse;html=1;fillColor=#154733;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="286" y="406" width="12" height="12" as="geometry" /></mxCell>
        <mxCell id="P12" value="" style="ellipse;html=1;fillColor=#154733;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="136" y="316" width="12" height="12" as="geometry" /></mxCell>
        <mxCell id="P22p" value="" style="ellipse;html=1;fillColor=none;strokeColor=#6E6E6E;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="326" y="296" width="12" height="12" as="geometry" /></mxCell>
        <mxCell id="P22a" value="" style="ellipse;html=1;fillColor=#875E00;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="368" y="330" width="12" height="12" as="geometry" /></mxCell>

        <mxCell id="Ea" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#154733;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="102" y="432" as="sourcePoint" /><mxPoint x="292" y="412" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="Eb" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#005581;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="102" y="432" as="sourcePoint" /><mxPoint x="142" y="322" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="Ea2" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#154733;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="142" y="322" as="sourcePoint" /><mxPoint x="332" y="302" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="Eb2" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#005581;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="292" y="412" as="sourcePoint" /><mxPoint x="332" y="302" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="Eg" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#875E00;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="332" y="302" as="sourcePoint" /><mxPoint x="374" y="336" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="L11" value="M[&lt;i&gt;dog&lt;/i&gt;, noun]" style="text;html=1;fontSize=10;align=right;" vertex="1" parent="1"><mxGeometry x="10" y="440" width="96" height="16" as="geometry" /></mxCell>
        <mxCell id="L21" value="M[&lt;i&gt;run&lt;/i&gt;, noun]" style="text;html=1;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="292" y="418" width="96" height="16" as="geometry" /></mxCell>
        <mxCell id="L12" value="M[&lt;i&gt;dog&lt;/i&gt;, verb]" style="text;html=1;fontSize=10;align=right;" vertex="1" parent="1"><mxGeometry x="42" y="300" width="94" height="16" as="geometry" /></mxCell>
        <mxCell id="L22p" value="where an additive&#10;model puts M[&lt;i&gt;run&lt;/i&gt;, verb]" style="text;html=1;fontSize=10;align=left;fontColor=#6E6E6E;" vertex="1" parent="1"><mxGeometry x="252" y="266" width="150" height="28" as="geometry" /></mxCell>
        <mxCell id="L22a" value="where it actually is" style="text;html=1;fontSize=10;align=left;fontColor=#875E00;fontStyle=1" vertex="1" parent="1"><mxGeometry x="382" y="336" width="96" height="16" as="geometry" /></mxCell>
        <mxCell id="Lga" value="α&#10;the item offset" style="text;html=1;fontSize=10;align=center;fontColor=#154733;fontStyle=1" vertex="1" parent="1"><mxGeometry x="150" y="428" width="100" height="28" as="geometry" /></mxCell>
        <mxCell id="Lgb" value="β&#10;the class offset" style="text;html=1;fontSize=10;align=left;fontColor=#005581;fontStyle=1" vertex="1" parent="1"><mxGeometry x="58" y="352" width="86" height="28" as="geometry" /></mxCell>
        <mxCell id="Lgg" value="γ" style="text;html=1;fontSize=14;align=left;fontColor=#875E00;fontStyle=1" vertex="1" parent="1"><mxGeometry x="352" y="304" width="20" height="20" as="geometry" /></mxCell>

        <mxCell id="Bnote" value="If the representation were item + class, knowing three corners would fix the fourth: the parallelogram would close. γ is the gap between where an additive model puts the fourth cell and where it actually sits. It is not error — the four components exhaust the grid exactly — it is the part that belongs to the pairing." style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#404040;" vertex="1" parent="1">
          <mxGeometry x="46" y="456" width="420" height="42" as="geometry" />
        </mxCell>

        <!-- ================= right column: the math ================= -->
        <mxCell id="Mh" value="The operationalization" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="512" y="52" width="300" height="20" as="geometry" />
        </mxCell>

        <mxCell id="M1" value="&lt;b&gt;Decompose&lt;/b&gt;, by centering the grid:&#10;&#10;M[i,c] = μ + α(i) + β(c) + γ(i,c)&#10;&#10;μ grand mean&amp;nbsp; · &amp;nbsp;α(i) row mean − μ&#10;β(c) column mean − μ&amp;nbsp; · &amp;nbsp;γ what remains" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#154733;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="512" y="74" width="440" height="106" as="geometry" />
        </mxCell>

        <mxCell id="M2" value="&lt;b&gt;How big is each part?&lt;/b&gt;&amp;nbsp; The four are orthogonal as sources, so their squared lengths partition the grid exactly and each is reported as a share:&#10;&#10;size(γ) = ‖γ‖² / ( ‖α‖² + ‖β‖² + ‖γ‖² )&#10;&#10;portable fraction = size(β) / ( size(β) + size(γ) )&#10;how much of what separates the class levels is a direction shared across words" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#875E00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="512" y="192" width="440" height="140" as="geometry" />
        </mxCell>

        <mxCell id="M3" value="&lt;b&gt;Do the parts share directions?&lt;/b&gt;&amp;nbsp; Orthogonality as sources does not constrain the directions they occupy, so both are measured as projections:&#10;&#10;item–class overlap = ‖proj&lt;sub&gt;S(β)&lt;/sub&gt; α‖² / ‖α‖²&#10;interaction overlap = ‖proj&lt;sub&gt;S(α)+S(β)&lt;/sub&gt; γ‖² / ‖γ‖²&#10;&#10;each read against chance = (subspace rank) / d" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#005581;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="512" y="344" width="440" height="140" as="geometry" />
        </mxCell>

        <!-- ================= C: overlap geometry ================= -->
        <mxCell id="Ch" value="C.&amp;nbsp; Overlap is an angle, not a size" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="36" y="516" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="Cbox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CCCCCC;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="36" y="538" width="440" height="164" as="geometry" />
        </mxCell>
        <mxCell id="Csub" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#005581;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="80" y="670" as="sourcePoint" /><mxPoint x="300" y="670" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="Csublab" value="the class subspace S(β)" style="text;html=1;fontSize=10;align=left;fontColor=#005581;" vertex="1" parent="1"><mxGeometry x="306" y="662" width="140" height="16" as="geometry" /></mxCell>
        <mxCell id="Cvec" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#154733;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="80" y="670" as="sourcePoint" /><mxPoint x="196" y="576" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="Cveclab" value="α" style="text;html=1;fontSize=13;align=left;fontColor=#154733;fontStyle=1" vertex="1" parent="1"><mxGeometry x="200" y="566" width="20" height="20" as="geometry" /></mxCell>
        <mxCell id="Cproj" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#6E6E6E;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="196" y="576" as="sourcePoint" /><mxPoint x="196" y="670" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="Cprojv" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#875E00;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="80" y="670" as="sourcePoint" /><mxPoint x="196" y="670" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="Cprojlab" value="the part of the item effect that&#10;lies along the class direction" style="text;html=1;fontSize=10;align=left;fontColor=#875E00;" vertex="1" parent="1"><mxGeometry x="92" y="676" width="200" height="26" as="geometry" /></mxCell>
        <mxCell id="Cnote" value="Near zero means projecting the class out leaves item identity intact. This is the one thing these representations do cleanly." style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#404040;" vertex="1" parent="1">
          <mxGeometry x="46" y="546" width="420" height="28" as="geometry" />
        </mxCell>

        <!-- ================= D: split-half ================= -->
        <mxCell id="Dh" value="D.&amp;nbsp; Why the grid is estimated twice" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="512" y="500" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="Dbox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CCCCCC;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="512" y="522" width="440" height="180" as="geometry" />
        </mxCell>
        <mxCell id="Dh1" value="half A&#10;of each cell's&#10;observations" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FBF7EE;strokeColor=#875E00;" vertex="1" parent="1">
          <mxGeometry x="536" y="546" width="104" height="52" as="geometry" />
        </mxCell>
        <mxCell id="Dh2" value="half B&#10;disjoint from A" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FBF7EE;strokeColor=#875E00;" vertex="1" parent="1">
          <mxGeometry x="536" y="614" width="104" height="52" as="geometry" />
        </mxCell>
        <mxCell id="Dg1" value="γ&lt;sub&gt;A&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#875E00;" vertex="1" parent="1">
          <mxGeometry x="672" y="554" width="56" height="36" as="geometry" />
        </mxCell>
        <mxCell id="Dg2" value="γ&lt;sub&gt;B&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#875E00;" vertex="1" parent="1">
          <mxGeometry x="672" y="622" width="56" height="36" as="geometry" />
        </mxCell>
        <mxCell id="De1" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#6E6E6E;" edge="1" parent="1" source="Dh1" target="Dg1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="De2" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#6E6E6E;" edge="1" parent="1" source="Dh2" target="Dg2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="Ddot" value="report ⟨ γ&lt;sub&gt;A&lt;/sub&gt; , γ&lt;sub&gt;B&lt;/sub&gt; ⟩&#10;not ‖γ‖²" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FBF7EE;strokeColor=#875E00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="768" y="580" width="150" height="52" as="geometry" />
        </mxCell>
        <mxCell id="De3" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#6E6E6E;" edge="1" parent="1" source="Dg1" target="Ddot"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="De4" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#6E6E6E;" edge="1" parent="1" source="Dg2" target="Ddot"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="Dnote" value="A squared length is bounded below by its own noise: it cannot read zero even when the truth is zero, and no permutation can test a magnitude. Independent errors cancel in a cross product, which is unbiased at any noise level and can come out negative — so it supports a real test.&#10;&#10;In the toy the halves are a cell's contexts; in a language model they are a word's sentences. Same function, same arguments." style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#404040;" vertex="1" parent="1">
          <mxGeometry x="522" y="672" width="424" height="26" as="geometry" />
        </mxCell>

        <mxCell id="foot" value="The same function measures the artificial learner and the language models, with the same arguments — no alignment between estimates, no projection." style="text;html=1;fontSize=11;fontStyle=2;align=left;fontColor=#154733;" vertex="1" parent="1">
          <mxGeometry x="36" y="716" width="916" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
