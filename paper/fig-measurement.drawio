<mxfile host="app.diagrams.net" agent="claude" version="24.0.0">
  <diagram id="measurement" name="measurement">
    <mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="820" math="0" shadow="0">
      <root>
